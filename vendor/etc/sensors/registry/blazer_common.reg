  lowG_peak_threshold=848
  lowG_detect_timeout_ms=20
  lowG_debounce_timeout_ms=1000
+/dev/icm45631/0/accel
  orientation_transform=1 2 3
  name=ICM45631 Accelerometer
  fac_cal_transform=0.9970 0.0072 -0.0042 -0.0085 0.9972 -0.0029 0.0045 0.0007 0.9990 -0.0180 -0.0320 -0.0626
  temp=34.2609
  temp_sensitivity=0.0002 -0.0002 -0.0007
+/dev/icm45631/0/gyro
  orientation_transform=1 2 3
  name=ICM45631 Gyroscope
  fac_cal_transform=0.9992 0.0078 -0.0064 -0.0067 1.0021 -0.0026 0.0064 0.0031 0.9979 0.0029 -0.0008 -0.0002
  temp=34.2609
  temp_sensitivity=0.00002 -0.00002 0.00001
+/dev/icm45631/0/temp
  name=ICM45631 Temperature
+/dev/icm45631/0/motion_detect
