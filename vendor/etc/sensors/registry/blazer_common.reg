  intr_id=37
  intr_type=1
  panel_height_pixel=2856
  panel_height_mm=147
  single_tap_min_x=107
  single_tap_max_x=1173
  single_tap_min_y=210
  single_tap_max_y=2646
  single_tap_min_frame_count=3
  single_tap_max_frame_count=31
  single_press_motion_tolerance=255
  single_press_max_touch_size=40
  long_press_min_x=523
  long_press_max_x=757
  long_press_min_y=1975
  long_press_max_y=2209
  long_press_min_frame_count=1
  long_press_motion_tolerance_inner=255
  long_press_max_touch_size=40
  long_press_marginal_min_x=523
  long_press_marginal_max_x=757
  long_press_marginal_min_y=1975
  long_press_marginal_max_y=2209
  long_press_monitor_channel_min_tx=6
  long_press_monitor_channel_max_tx=9
  long_press_monitor_channel_min_rx=24
  long_press_monitor_channel_max_rx=27
  long_press_min_node_count=8
  long_press_motion_tolerance_outer=599
  long_press_int2_deassert_min_x=464
  long_press_int2_deassert_max_x=816
  long_press_int2_deassert_min_y=1916
  long_press_int2_deassert_max_y=2268
  lptw_support_int2=1
  send_lptw_to_kernel=1
