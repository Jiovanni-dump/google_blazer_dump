#
# Blazer sensor device configuration registry script for all stages.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-lga
#

?+0x40000:0xFFFF0000

#
# Buses
#

# I2C
+/dev/i2c/2
  bus_name=i2c2
  bus_index=2

# I3C
+/dev/i3c/0
  bus_name=i3c0
  bus_index=0
+/dev/i3c/4
  bus_name=i3c4
  bus_index=4

# SPI
+/dev/spi/3
  bus_name=spi3
  bus_index=3

# PDM
+/dev/pdm
  base_clk_hz=38400000

#
# Sensors
#

# ALSP (TMD3743)
+/dev/tmd3743/0
  bus_name=i2c2
  bus_freq_hz=400000
  bus_addr=0x39
  intr_id=3
  intr_gpio_id=86
  anti_aliasing=1
  interlacing=1
  is_te2_node_enabled=1
  is_changable_pwm_supported=1
  # Leakage model type to use to calculate display leakage.
  #  0 : Compensate Lux using weighted Luma.
  #  1 : Compensate Lux using legacy plus modified C-channel histogram.
  #  2 : Compensate calculated XYZ values.
  #  3 : Compensate CRGBW channels.
  leakage_model_type=3

+/dev/tmd3743/0/prox
  auto_baseline=1
  gain1=64
  gain2=1
  temp_coeff=16
  pdata_scale=4.295
  pdata_baseline=5716
  far_threshold=900
  near_threshold=1500
  min_fps=30

+/dev/tmd3743/0/als
  # Display PWM table and dependent parameters.
  pwm_hz=240 480
  vsync_delay_us=712 706

  # DBV table and dependent parameters for each frequency in pwm_hz table.
  #   Each parameter is appended with an index, equal to the index of the
  #   PWM frequency it corresponds to, in the pwm_hz table.
  itime_table_brightness_0=3000 16384
  itime_table_0=1600000 300000
  max_gain_table_0=7 7
  prox_delay_1hz_0=96000 96000
  prox_delay_10hz_0=92000 92000
  prox_delay_30hz_0=29000 29000
  prox_delay_60hz_0=13000 13000
  prox_delay_120hz_0=6100 6100
  itime_table_brightness_1=1500 3000 16384
  itime_table_1=1600000 1200000 300000
  max_gain_table_1=7 7 7
  prox_delay_1hz_1=96000 96000 96000
  prox_delay_10hz_1=92000 92000 92000
  prox_delay_30hz_1=29000 29000 29000
  prox_delay_60hz_1=13000 13000 13000
  prox_delay_120hz_1=6100 6100 6100

  # Lux Filter parameters
  fast_filter_size=10
  slow_filter_size=100
  aod_fast_filter_size=3
  aod_slow_filter_size=3

  # Histogram Configuration.
  histo_enable=1
  # Display coordinates go from top left to bottom right.
  histo_roi_left=375
  histo_roi_top=175
  histo_roi_right=475
  histo_roi_bottom=275
  # The maximum brightness (DBV) value up to which histogram is active.
  # This value should match one of the itime_table_brightness values.
  histo_max_brightness=16384
  # Minimum change needed for a leakage value to be reported, i.e.,
  # min_change = MAX(min_change_value, current_leakage_val * min_change_rate)
  histo_min_change_value=0.5
  histo_min_change_rate=0.01
  # Histogram polling interval in ms.
  histo_polling_interval=50
  # Fallback luma value to use when histogram returns error (e.g., due to DRM).
  histo_fallback_luma=128.0

  ## Leakage calculator configuration.

  # Histo Luma matrix coefficients.
  # Format: histo_luma_matrix_<pwm_hz>_<n> = <start_DBV> <end_DBV> <<co-effs of luma-term matrix>>
  #         where: pwm_hz = PWM frequency; n = Luma matrix count.
  # The luma-term matrix applies for the given pwm_hz, when "start_DBV <= current_DBV <= end_DBV".
  histo_luma_matrix_240_0=0 3200 0.46060098 0.31516745 0.22423157 0.45128745 0.34238286 0.20632969 0.29361359 0.49811475 0.20827166 -4.30747067 0.14866636 5.15880431 0.41937824 0.41152683 0.16909494
  histo_luma_matrix_240_1=3201 16384 0.41326402 0.4779782 0.10875778 0.58890549 0.35055084 0.06054367 0.08546265 0.8083959 0.10614145 0.0698555 0.53507414 0.39507036 0.46905648 0.42656985 0.10437366
  histo_luma_matrix_480_0=0 3200 0.38570168 0.48939505 0.12490328 0.65741176 0.30011737 0.04247087 0.08043832 0.86625148 0.0533102 0.1115493 0.48993061 0.39852009 0.42115657 0.46943616 0.10940727
  histo_luma_matrix_480_1=3200 16384 0.45908574 0.49157165 0.04934261 0.616911 0.32345589 0.0596331 0.16426004 0.74164859 0.09409138 0.20698833 0.42552438 0.3674873 0.50426712 0.40563954 0.09009334

  # Histo Luma exponent table.
  # Format: histo_luma_exp = <DBV1 exponent1> <DBV2 exponent2> ... <DBV_n exponent_n>
  #         where: DBV1 < DBV2 < ... < DBV_n.
  # For current_DBV, "exponent_x" value from first pair satisfying "current_DBV <= DBV_x" is chosen.
  histo_luma_exp=16384 1.5

  # Histo DBV equations.
  # Format: histo_dbv_eq_<pwm_hz>_<channel_index>_<n> = <start_DBV> <end_DBV> <eq_type>
  #                                                     <<equation co-efficients>>
  #         where: pwm_hz = PWM freq; channel_index = Leakage channel index enumerated as CRGBW;
  #                n = DBV equation count.
  # The DBV-term equation applies for the given pwm_hz, for the given leakage channel,
  # when "start_DBV <= current_DBV <= end_DBV".
  histo_dbv_eq_240_0_0=0 701 0 0
  histo_dbv_eq_240_0_1=702 3000 0 0.25506429371763945 4.699248956645213e-05 7.063840910244276e-08
  histo_dbv_eq_240_0_2=3001 16384 0 -0.40111958188897645 0.0002296192874568832 -3.135000406786354e-08 1.61903198452613e-12
  histo_dbv_eq_240_1_0=0 701 0 0
  histo_dbv_eq_240_1_1=702 3000 0 0.2626699768069447 3.4956926181511275e-05 7.213716285651691e-08
  histo_dbv_eq_240_1_2=3001 16384 0 -0.3461261058504688 0.00020562388899741433 -2.8292516228954586e-08 1.510851637386324e-12
  histo_dbv_eq_240_2_0=0 701 0 0
  histo_dbv_eq_240_2_1=702 3000 0 0.14507884016709033 0.00012836678431609475 5.291035564258434e-08
  histo_dbv_eq_240_2_2=3001 16384 0 -0.19009576680906137 0.00012420795210750656 -1.554480524311156e-08 9.445183827922457e-13
  histo_dbv_eq_240_3_0=0 701 0 0
  histo_dbv_eq_240_3_1=702 3000 0 -0.11825036699332839 0.0003179890790218553 -1.7894671901143024e-09
  histo_dbv_eq_240_3_2=3001 16384 0 -0.4847840187005015 0.00024527832263931677 -3.331736411983678e-08 1.6630465207672315e-12
  histo_dbv_eq_240_4_0=0 701 0 0
  histo_dbv_eq_240_4_1=702 3000 0 0.2552882240372846 2.2746603576099893e-05 7.042534546105147e-08
  histo_dbv_eq_240_4_2=3001 16384 0 -0.2864095434720848 0.000174252521466033 -2.4081749718100473e-08 1.3465707781465737e-12

  histo_dbv_eq_480_0_0=0 701 0 0
  histo_dbv_eq_480_0_1=702 3000 0 6.0879194806630865 -0.027783307509148113 5.093083670383397e-05 -4.607889571755015e-08 2.1944624354324723e-11 -5.276940530684406e-15 5.0584626255206775e-19
  histo_dbv_eq_480_0_2=3001 16384 0 -0.11478139136130472 8.391764341391296e-05 -9.132855929947934e-09 6.733028780151947e-13
  histo_dbv_eq_480_1_0=0 701 0 0
  histo_dbv_eq_480_1_1=702 3000 0 6.489745753724437 -0.028715607708812003 5.143173070481757e-05 -4.5803565973327507e-08 2.1590407573297433e-11 -5.157499272937478e-15 4.922854442981406e-19
  histo_dbv_eq_480_1_2=3001 16384 0 -0.06578489700423026 6.081191925368026e-05 -5.950276978506495e-09 5.416677698977169e-13
  histo_dbv_eq_480_2_0=0 701 0 0
  histo_dbv_eq_480_2_1=702 3000 0 4.598371929684198 -0.022439907907740118 4.30930675754737e-05 -4.0236531470522234e-08 1.9618570582624872e-11 -4.806473436374527e-15 4.678931713518114e-19
  histo_dbv_eq_480_2_2=3001 16384 0 -0.060104191429970914 4.042671936724474e-05 -5.65973665776278e-10 2.4263639776145096e-13
  histo_dbv_eq_480_3_0=0 701 0 0
  histo_dbv_eq_480_3_1=702 3000 0 1.8006606534586087 -0.010589531782152358 2.3549722535881756e-05 -2.419023032270379e-08 1.2635281761717566e-11 -3.2671817073586737e-15 3.32715927951753e-19
  histo_dbv_eq_480_3_2=3001 16384 0 -0.05312076850194633 4.5352777245980605e-05 -4.9430791658276705e-09 5.200767458159582e-13
  histo_dbv_eq_480_4_0=0 701 0 0
  histo_dbv_eq_480_4_1=702 3000 0 7.668119838557631 -0.033925958980864236 6.0312826479669073e-05 -5.338369170469144e-08 2.5026657698757196e-11 -5.9480240062320706e-15 5.649069218226689e-19
  histo_dbv_eq_480_4_2=3001 16384 0 -0.04843888362939177 4.896018556245746e-05 -4.5554777682984645e-09 4.990502802596509e-13

  # Golden value for fac-cal leakages.
  crgbw_leakage_at_dbv=240.0000 20.24 13.17 3.45 0.17 20.03 3000.0000 240.0000 29.35 19.64 10.63 5.41 29.80 13418.0000 480.0000 66.14 37.83 23.10  7.07 66.03 3000.0000 480.0000 37.04 23.30 12.52 6.10 39.94 13418.0000

