#
# Blazer sensor device configuration registry script for the EVT 1.1 stage.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-lga
#

?+0x43000:0xFFFFF000  # EVT stage
# Exclude
?-0x43100:0xFFFFFFF0  # EVT 1.0

#
# Record reg_script.
#

+/
reg_script=blazer_evt_1_1.reg

#
# Sensors
#

# MAG (MC5616WA)
+/dev/mmc5616/0/mag
  fac_cal_transform= 0.9362 0.0680 0.0290 0.1220 1.0173 0.0297 -0.0254 -0.0046 1.1329  0 0 0
  curr_comp_factors_fast=3.2 2.3 7.0
  curr_comp_factors=6.4 4.5 13.7

# ALSP (TMD3743)
+/dev/tmd3743/0/als
  x_scale=1.10666
  lux_scale=1.0202
  z_scale=1.1077
  x_crgbw_coefs=-37.408235 43.854591 129.513772 -9.300066 -2.601188
  lux_crgbw_coefs=-27.257599 26.672212 124.899590 0.132850 -1.952329
  z_crgbw_coefs=30.456540 -57.486146 -0.813766 132.762996 1.365894

+/dev/tmd3743/0/prox
  pulse_count=2
  pulse_len_us=63

# RAINBOW (VD6282)
+/dev/vd6282/0/spectral
  # Golden values for calibration.
  golden_rals_r=990.849609375
  golden_rals_g=1123.46484375
  golden_rals_b=282.928515625
  golden_rals_clr1=4913.31015625
  golden_rals_ir=2971.34726563
  golden_rals_clr2=4913.23671875

+/dev/vd6282/0/rls
  lux_scale=109.740506
