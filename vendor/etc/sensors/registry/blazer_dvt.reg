#
# Blazer sensor device configuration registry script for the DVT stage and after.
#
# Source of truth: go/pixel-sensor-list
#

#
# CDT Filter <CDT>:<mask>
# CDT format: <0xPPPPSJIV> (P:Product, S:Stage, J:Major, I:Minor, V:Variant)
# go/pixel-cdt-lga
#

?+0x40000:0xFFFF0000
# Exclude
?-0x42000:0xFFFFF000  # Proto
?-0x43000:0xFFFFF000  # EVT

#
# Record reg_script.
#

+/
reg_script=blazer_dvt.reg

#
# Sensors
#

# MAG (MC5616WA)
+/dev/mmc5616/0/mag
  fac_cal_transform=0.9941 0.0670 0.0259 0.1129 0.9495 0.0304 -0.0017 0.0137 1.0857 0 0 0
  curr_comp_factors_fast=4.06 2.88 7.05
  curr_comp_factors=7.0 4.6 12.8

# ALSP (TMD3743)
+/dev/tmd3743/0/als
  x_scale=1.10666
  lux_scale=1.0202
  z_scale=1.1077
  x_crgbw_coefs=-37.408235 43.854591 129.513772 -9.300066 -2.601188
  lux_crgbw_coefs=-27.257599 26.672212 124.899590 0.132850 -1.952329
  z_crgbw_coefs=30.456540 -57.486146 -0.813766 132.762996 1.365894

+/dev/tmd3743/0/prox
  pulse_count=2
  pulse_len_us=63

# RAINBOW (VD6282)
+/dev/vd6282/0/spectral
  # Golden values for calibration.
  golden_rals_r=1021.53320312
  golden_rals_g=1168.49453125
  golden_rals_b=303.6671875
  golden_rals_clr1=5173.56875
  golden_rals_ir=3090.503125
  golden_rals_clr2=5214.58125

+/dev/vd6282/0/rls
  lux_scale=105.511491
